# QuakeRoute Mobile — Environment Example
# Copy to .env and adjust for local development.
# All values are placeholders; no secrets are committed.

# Backend REST base URL (must end without trailing slash)
# Example: http://10.0.2.2:8000/api/v1 for Android emulator -> host Laravel
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Lightweight session identifier used as X-Session-Id header (TBD auth, api-specification.md §1)
# Generate a UUID locally; backend will create a users row on first use if needed.
SESSION_ID=local-dev-session-id

# OSM-compatible tile provider (TBD, tech-stack.md §5.3)
# Default uses public OSM tiles; replace if self-hosted.
TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
